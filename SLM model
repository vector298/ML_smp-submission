model     = GPT(cfg).to(device)
optimizer = torch.optim.AdamW(model.parameters(), lr=3e-4, weight_decay=0.1)
scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=max_iters, eta_min=1e-5)

eval_interval = 500
eval_iters    = 50
best_val_loss = float("inf")
train_losses  = []
val_losses    = []

@torch.no_grad()
def estimate_loss():
    model.eval()
    out = {}
    for split in ["train", "val"]:
        losses = []
        for _ in range(eval_iters):
            x, y = get_batch(split)
            _, loss = model(x, y)
            losses.append(loss.item())
        out[split] = sum(losses) / len(losses)
    model.train()
    return out

model.train()
for it in range(max_iters):
    x, y    = get_batch("train")
    _, loss = model(x, y)
    loss.backward()
    torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
    optimizer.step()
    scheduler.step()
    optimizer.zero_grad()

    if it % eval_interval == 0 or it == max_iters - 1:
        stats = estimate_loss()
        print(f"iter {it:4d} | train loss {stats['train']:.4f} | val loss {stats['val']:.4f}")
        train_losses.append(stats["train"])
        val_losses.append(stats["val"])
        if stats["val"] < best_val_loss:
            best_val_loss = stats["val"]
            torch.save(model.state_dict(), "best_model.pt")
            print(f"  -> checkpoint saved (val loss {best_val_loss:.4f})")

plt.figure(figsize=(8, 5))
